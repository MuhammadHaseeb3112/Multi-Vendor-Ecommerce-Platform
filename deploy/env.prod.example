# Copy to deploy/.env.prod on the server and fill in. Never commit .env.prod.

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=markethub
POSTGRES_USER=markethub

# Your domain (no https:// in ALLOWED_HOSTS, with https:// in CSRF_TRUSTED_ORIGINS)
ALLOWED_HOSTS=markethub.example.com
CSRF_TRUSTED_ORIGINS=https://markethub.example.com
SECURE_COOKIES=True

# Public demo: shared demo logins, demo data on first start, no outgoing email
DEMO_MODE=True
DEMO_PASSWORD=DemoPass123!
