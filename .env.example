# Copy to .env and fill in real values. Never commit .env.
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Set False when running over plain http (e.g. docker compose locally)
SECURE_COOKIES=False
SERVE_MEDIA=True

# PostgreSQL (leave POSTGRES_DB empty to use SQLite)
POSTGRES_DB=markethub
POSTGRES_USER=markethub
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email (Gmail: use an App Password, never your account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_RECIPIENT_EMAIL=
ADMIN_EMAIL=
